{
  "name": "the-gardener",
  "version": "2.0.0",
  "description": "The Gardener\u2122 \u2014 a self-cultivating, 24/7 ambient dashboard that improves itself daily.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "iterate": "node src/iterate.mjs",
    "smoke": "node smoke/smoke.mjs",
    "day": "node src/display.mjs day",
    "night": "node src/display.mjs night",
    "display-sync": "node src/display.mjs sync",
    "design:check": "node tools/design.mjs validate-all && node tools/design.mjs lint-all && node tools/design.mjs schema && node --test tools/design/test.mjs",
    "design:audit": "node tools/design.mjs audit",
    "design:catalog": "node tools/design/catalog.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.287",
    "@anthropic-ai/sdk": "^0.100.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.0.0",
    "sherpa-onnx-node": "^2.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.0.0"
  }
}
