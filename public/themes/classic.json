    "todo-assignment-field": {
      "selector": ".todo-assignment-field",
      "style": {
        "display": "flex",
        "align-items": "center",
        "flex-wrap": "wrap",
        "gap": "12px"
      }
    },
    "todo-assignees": {
      "selector": ".todo-assignees",
      "style": {
        "position": "relative",
        "min-width": "150px",
        "font": "16px/1.4 var(--font-body)"
      }
    },
    "todo-assignee-summary": {
      "selector": ".todo-assignees > summary",
      "style": {
        "padding": "10px 14px",
        "border": "1px solid var(--stroke)",
        "border-radius": "12px",
        "background": "var(--color-canvas-raised)",
        "color": "var(--color-text-primary)",
        "cursor": "var(--cursor-pointer)"
      }
    },
    "todo-assignee-menu": {
      "selector": ".todo-assignee-menu",
      "style": {
        "position": "absolute",
        "z-index": "30",
        "top": "calc(100% + 8px)",
        "left": "0",
        "width": "240px",
        "max-width": "calc(100vw - 80px)",
        "padding": "12px",
        "border": "1px solid var(--stroke)",
        "border-radius": "14px",
        "background": "var(--color-canvas-raised)",
        "color": "var(--color-text-primary)"
      }
    },
    "todo-assignee-menu-above": {
      "selector": ".todo-assignees[data-placement=above] .todo-assignee-menu",
      "style": {
        "top": "auto",
        "bottom": "calc(100% + 8px)"
      }
    },
    "todo-assignee-tools": {
      "selector": ".todo-assignee-tools",
      "style": {
        "display": "flex",
        "align-items": "center",
        "justify-content": "space-between",
        "gap": "20px",
        "padding": "0 4px 8px",
        "color": "var(--color-text-muted)"
      }
    },
    "todo-assignee-all": {
      "selector": ".todo-assignee-menu .todo-assignee-all",
      "style": {
        "font": "inherit",
        "padding": "5px 12px",
        "border": "1px solid var(--stroke)",
        "border-radius": "8px",
        "background": "transparent",
        "color": "var(--color-accent)",
        "cursor": "var(--cursor-pointer)"
      }
    },
    "todo-assignee-option": {
      "selector": ".todo-assignee-option",
      "style": {
        "display": "flex",
        "align-items": "center",
        "gap": "12px",
        "padding": "9px 6px",
        "border-radius": "8px",
        "cursor": "var(--cursor-pointer)"
      }
    },
    "todo-assignee-option-hover": {
      "selector": ".todo-assignee-option:hover",
      "style": {
        "background": "var(--color-canvas)"
      }
    },
    "todo-assignee-option-check": {
      "selector": ".todo-assignee-option input",
      "style": {
        "flex": "0 0 20px",
        "width": "20px",
        "height": "20px",
        "min-width": "20px",
        "margin": "0",
        "padding": "0",
        "accent-color": "var(--color-accent)"
      }
    },
    "todo-assignee-focus": {
      "selector": ".todo-assignees summary:focus-visible, .todo-assignee-all:focus-visible, .todo-assignee-option input:focus-visible",
      "style": {
        "outline": "2px solid var(--color-accent)",
        "outline-offset": "3px"
      }
    },
    "todo-task-header": {
      "selector": ".todo-task-header",
      "style": {
        "display": "flex",
        "justify-content": "space-between",
        "align-items": "flex-start",
        "flex-wrap": "wrap",
        "gap": "16px 24px"
      }
    },
    "todo-task-header-line": {
      "selector": ".todo-task-header > .todo-full-line",
      "style": {
        "flex": "1 1 260px",
        "min-width": "0"
      }
    },
    "todo-task-header-assignment": {
      "selector": ".todo-task-header > .todo-assignment-field",
      "style": {
        "flex": "0 0 auto",
        "margin-left": "auto"
      }
    }
  },
  "widgets": {},
  "$schema": "./schema/theme.schema.json"
}
