{
  "version": 1,
  "id": "classic",
  "label": "Garden Classic",
  "tokens": {
    "palette": {
      "--palette-canvas": "#04110d",
      "--palette-canvas-raised": "#07201a",
      "--palette-text-primary": "#eafff4",
      "--palette-text-secondary": "#a8c8bd",
      "--palette-text-muted": "#8aafa3",
      "--palette-accent": "#74f7b0",
      "--palette-accent-secondary": "#43e6c6",
      "--palette-warning": "#ffd98a",
      "--palette-error": "#ff9bb0"
    },
    "colors": {
      "--color-canvas": "var(--palette-canvas)",
      "--color-canvas-raised": "var(--palette-canvas-raised)",
      "--color-text-primary": "var(--palette-text-primary)",
      "--color-text-secondary": "var(--palette-text-secondary)",
      "--color-text-muted": "var(--palette-text-muted)",
      "--color-accent": "var(--palette-accent)",
      "--color-accent-secondary": "var(--palette-accent-secondary)",
      "--color-warning": "var(--palette-warning)",
      "--color-error": "var(--palette-error)"
    },
    "typography": {
      "--font-body": "\"Barlow Semi Condensed\", \"Inter\", \"SF Pro Display\", system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", sans-serif",
      "--font-heading": "\"The Garden\", \"Space Grotesk\", \"Inter\", system-ui, sans-serif",
      "--font-code": "\"Barlow Semi Condensed\", \"Inter\", system-ui, sans-serif"
    },
    "spacing": {
      "--space-grid-gap": "9px",
      "--space-card-padding": "20px"
    },
    "shape": {
      "--radius-card": "26px"
    },
    "materials": {
      "--surface-glass": "rgba(17, 43, 36, 0.72)",
      "--surface-glass-raised": "rgba(12, 32, 27, 0.82)",
      "--border-subtle": "rgba(140, 240, 195, 0.16)",
      "--border-strong": "rgba(140, 240, 195, 0.30)",
      "--shadow-overlay": "0 18px 50px rgba(0, 0, 0, 0.45)",
      "--glass-base": "rgba(20, 50, 42, 0.50)",
      "--glass-fill": "linear-gradient(157deg, rgba(204, 255, 234, 0.15) 0%, rgba(126, 218, 191, 0.06) 40%, rgba(34, 94, 78, 0.045) 100%)",
      "--glass-tint": "rgba(16, 44, 37, 0.34)",
      "--glass-rim": "rgba(198, 255, 231, 0.26)",
      "--glass-edge": "inset 0 1px 0 rgba(238, 255, 249, 0.42), inset 0 0 0 1px rgba(170, 240, 214, 0.05), inset 0 -26px 42px -24px rgba(0, 28, 20, 0.55)",
      "--glass-drop": "0 22px 48px -18px rgba(0, 0, 0, 0.55), 0 6px 16px -10px rgba(0, 0, 0, 0.5)",
      "--shadow-drag-ghost": "0 20px 60px #0008"
    },
    "cursor": {
      "--cursor-default": "url('/assets/cursors/arrow.svg') 2 2, default",
      "--cursor-pointer": "url('/assets/cursors/hand.svg') 10 2, pointer",
      "--cursor-text": "url('/assets/cursors/text.svg') 8 13, text"
    },
    "overrides": {}
  },
  "components": {
    "home-editing": {
      "selector": "body[data-dash=\"main\"] #garden.home-paged > .card.widget-editing",
      "style": {
        "outline": "1px dashed var(--border-strong)",
        "outline-offset": "-2px",
        "touch-action": "none",
        "user-select": "none",
        "overflow": "hidden !important"
      }
    },
    "home-edit-stable": {
      "selector": "body[data-dash=\"main\"].editing-widgets #garden.home-paged",
      "style": {
        "padding": "2px !important",
        "gap": "var(--space-grid-gap) !important",
        "overflow": "hidden !important"
      }
    },
    "home-dots": {
      "selector": ".home-page-dots > button",
      "style": {
        "width": "24px !important"
      }
    },
    "home-editbar": {
      "selector": ".home-edit-bar",
      "style": {
        "top": "auto",
        "bottom": "26px",
        "left": "30px",
        "right": "30px",
        "height": "62px",
        "padding": "8px",
        "box-sizing": "border-box",
        "border-radius": "31px",
        "background": "var(--color-canvas-raised)",
        "gap": "12px"
      }
    },
    "home-input-edit": {
      "selector": "body[data-dash=\"main\"].editing-widgets #feedbackForm",
      "style": {
        "visibility": "hidden"
      }
    },
    "home-controls": {
      "selector": "body[data-dash=\"main\"] #garden.home-paged > .card > .widget-edit-controls",
      "style": {
        "inset": "0",
        "display": "block",
        "pointer-events": "none"
      }
    },
    "home-control-button": {
      "selector": "body[data-dash=\"main\"] #garden.home-paged > .card > .widget-edit-controls > button",
      "style": {
        "position": "absolute",
        "width": "28px",
        "height": "28px",
        "padding": "0",
        "font-size": "18px",
        "pointer-events": "auto",
        "min-width": "28px",
        "min-height": "28px",
        "box-sizing": "border-box"
      }
    },
    "home-remove": {
      "selector": "body[data-dash=\"main\"] #garden.home-paged > .card > .widget-edit-controls > button:first-child:not(.widget-drag-handle)",
      "style": {
        "top": "max(7px, calc(var(--radius-card) - 15px))",
        "right": "max(7px, calc(var(--radius-card) - 15px))"
      }
    },
    "home-move": {
      "selector": "body[data-dash=\"main\"] #garden.home-paged > .card > .widget-edit-controls > .widget-drag-handle",
      "style": {
        "bottom": "6px",
        "left": "6px",
        "opacity": "0",
        "pointer-events": "none"
      }
    },
    "home-resize": {
      "selector": "body[data-dash=\"main\"] #garden.home-paged > .card > .widget-edit-controls > button:last-child",
      "style": {
        "bottom": "auto",
        "right": "calc(max(7px, calc(var(--radius-card) - 15px)) + 44px)",
        "top": "max(7px, calc(var(--radius-card) - 15px))"
      }
    },
    "home-drop": {
      "selector": "body[data-dash=\"main\"] #garden.home-paged > .card.widget-drop-target",
      "style": {
        "outline": "2px solid var(--color-accent)",
        "outline-offset": "-3px"
      }
    },
    "home-ghost": {
      "selector": ".home-drag-ghost",
      "style": {
        "z-index": "185",
        "pointer-events": "none",
        "opacity": ".85",
        "margin": "0",
        "transform": "none",
        "overflow": "hidden",
        "box-sizing": "border-box",
        "box-shadow": "var(--shadow-drag-ghost)"
      }
    },
    "home-picker": {
      "selector": ".widget-size-picker",
      "style": {
        "position": "fixed",
        "z-index": "184",
        "left": "24px",
        "right": "24px",
        "bottom": "100px",
        "padding": "20px",
        "border": "1px solid var(--border-strong)",
        "border-radius": "32px",
        "background": "var(--color-canvas-raised)",
        "color": "var(--color-text-primary)",
        "box-shadow": "var(--shadow-overlay)"
      }
    },
    "home-picker-hidden": {
      "selector": ".widget-size-picker[hidden]",
      "style": {
        "display": "none"
      }
    },
    "home-picker-head": {
      "selector": ".widget-size-picker h2",
      "style": {
        "font": "28px var(--font-heading)",
        "margin": "0"
      }
    },
    "home-picker-p": {
      "selector": ".widget-size-picker p",
      "style": {
        "color": "var(--color-text-secondary)",
        "margin": "12px 0 24px"
      }
    },
    "home-picker-options": {
      "selector": ".widget-size-options",
      "style": {
        "display": "grid",
        "grid-template-columns": "repeat(3,minmax(0,1fr))",
        "gap": "12px"
      }
    },
    "home-picker-button": {
      "selector": ".widget-size-picker button",
      "style": {
        "font": "inherit",
        "color": "var(--color-text-primary)",
        "background": "var(--surface-glass-raised)",
        "border": "1px solid var(--border-subtle)",
        "border-radius": "calc(32px - 20px - 1px)",
        "padding": "12px",
        "cursor": "pointer"
      }
    },
    "home-picker-option": {
      "selector": ".widget-size-options button",
      "style": {
        "display": "flex",
        "flex-direction": "column",
        "align-items": "stretch",
        "gap": "10px",
        "min-height": "240px",
        "text-align": "left",
        "padding": "12px"
      }
    },
    "home-picker-description": {
      "selector": ".widget-size-options button > span:last-child",
      "style": {
        "font-size": "13px",
        "color": "var(--color-text-secondary)"
      }
    },
    "home-picker-selected": {
      "selector": ".widget-size-options button[aria-pressed=\"true\"]",
      "style": {
        "border": "1px solid var(--color-accent)",
        "background": "var(--surface-glass)",
        "box-shadow": "inset 0 0 0 1px var(--color-accent)"
      }
    },
    "home-picker-shape": {
      "selector": ".widget-size-shape",
      "style": {
        "display": "block",
        "width": "38px",
        "height": "28px",
        "border": "1px solid var(--color-text-secondary)",
        "border-radius": "6px",
        "background": "var(--border-subtle)"
      }
    },
    "home-picker-medium": {
      "selector": ".widget-size-shape.medium",
      "style": {
        "height": "42px"
      }
    },
    "home-picker-wide": {
      "selector": ".widget-size-shape.wide",
      "style": {
        "width": "70px",
        "height": "35px"
      }
    },
    "home-picker-tall": {
      "selector": ".widget-size-shape.tall",
      "style": {
        "height": "62px"
      }
    },
    "home-picker-large": {
      "selector": ".widget-size-shape.large",
      "style": {
        "width": "70px",
        "height": "62px"
      }
    },
    "home-move-focus": {
      "selector": "body[data-dash=\"main\"] #garden.home-paged > .card > .widget-edit-controls > .widget-drag-handle:focus-visible",
      "style": {
        "opacity": "1"
      }
    },
    "home-clock-resize": {
      "selector": "body[data-dash=\"main\"] #garden.home-paged > .card[data-wid=\"clock\"] > .widget-edit-controls > button:last-child",
      "style": {
        "right": "max(7px, calc(var(--radius-card) - 15px))"
      }
    },
    "home-no-spacer": {
      "selector": "body[data-dash=\"main\"] #garden.home-paged::after",
      "style": {
        "display": "none !important"
      }
    },
    "home-explicit-small": {
      "selector": "body[data-dash=\"main\"] #garden.home-paged > .card[data-wsize=\"small\"]",
      "style": {
        "overflow": "hidden !important"
      }
    },
    "home-explicit-medium": {
      "selector": "body[data-dash=\"main\"] #garden.home-paged > .card[data-wsize=\"medium\"]",
      "style": {
        "overflow": "hidden !important"
      }
    },
    "home-explicit-wide": {
      "selector": "body[data-dash=\"main\"] #garden.home-paged > .card[data-wsize=\"wide\"]",
      "style": {
        "overflow": "hidden !important"
      }
    },
    "home-explicit-tall": {
      "selector": "body[data-dash=\"main\"] #garden.home-paged > .card[data-wsize=\"tall\"]",
      "style": {
        "overflow": "hidden !important"
      }
    },
    "home-explicit-large": {
      "selector": "body[data-dash=\"main\"] #garden.home-paged > .card[data-wsize=\"large\"]",
      "style": {
        "overflow": "hidden !important"
      }
    },
    "changelog-message": {
      "selector": ".changelog .cl-phrase",
      "style": {
        "display": "block",
        "-webkit-line-clamp": "unset",
        "overflow": "visible",
        "overflow-wrap": "anywhere"
      }
    },
    "variant-bare-frame": {
      "selector": "body[data-dash=\"main\"] #garden.home-paged > .card[data-wsize].bare",
      "style": {
        "padding": "16px"
      }
    },
    "variant-body": {
      "selector": "body[data-dash=\"main\"] #garden.home-paged > .card[data-wsize] > .widget-variant-body",
      "style": {
        "height": "100%",
        "min-height": "0",
        "width": "100%"
      }
    },
    "variant-hidden-source": {
      "selector": "body[data-dash=\"main\"] #garden.home-paged > .card[data-wsize] > .card-body[hidden], body[data-dash=\"main\"] #garden.home-paged > .card[data-wsize] > .widget-original-body[hidden]",
      "style": {
        "display": "none !important"
      }
    },
    "variant-composition": {
      "selector": ".wv",
      "style": {
        "display": "flex",
        "flex-direction": "column",
        "height": "100%",
        "min-height": "0",
        "min-width": "0",
        "gap": "14px",
        "font-family": "var(--font-body)",
        "font-size": "18px",
        "line-height": "1.25",
        "color": "var(--color-text-primary)",
        "box-sizing": "border-box"
      }
    },
    "variant-muted": {
      "selector": ".wv-muted",
      "style": {
        "font-size": "14px",
        "color": "var(--color-text-secondary)",
        "line-height": "1.25"
      }
    },
    "variant-note": {
      "selector": ".wv-note",
      "style": {
        "font-size": "17px",
        "line-height": "1.3"
      }
    },
    "variant-footnote": {
      "selector": ".wv-footnote",
      "style": {
        "font-size": "13px",
        "color": "var(--color-text-muted)",
        "margin-top": "auto",
        "flex": "0 0 auto"
      }
    },
    "variant-eyebrow": {
      "selector": ".wv-eyebrow",
      "style": {
        "font-size": "13px",
        "letter-spacing": ".06em",
        "text-transform": "uppercase",
        "color": "var(--color-text-secondary)"
      }
    },
    "variant-stat": {
      "selector": ".wv-stat",
      "style": {
        "display": "flex",
        "flex-direction": "column",
        "gap": "6px",
        "justify-content": "center"
      }
    },
    "variant-value": {
      "selector": ".wv-value",
      "style": {
        "font": "64px var(--font-heading)",
        "line-height": "1"
      }
    },
    "variant-stat-label": {
      "selector": ".wv-stat > .wv-muted",
      "style": {
        "font": "24px var(--font-heading)",
        "color": "var(--color-text-secondary)"
      }
    },
    "variant-clock": {
      "selector": ".wv-clock",
      "style": {
        "justify-content": "center"
      }
    },
    "variant-clock-face": {
      "selector": ".wv-clock-face",
      "style": {
        "display": "flex",
        "flex-direction": "column",
        "gap": "6px",
        "min-width": "0"
      }
    },
    "variant-poem": {
      "selector": ".wv-poem",
      "style": {
        "font-size": "16px",
        "color": "var(--color-text-secondary)"
      }
    },
    "variant-time": {
      "selector": ".wv-time",
      "style": {
        "font": "70px var(--font-heading)",
        "line-height": "1",
        "white-space": "nowrap"
      }
    },
    "variant-clock-wide": {
      "selector": ".wv-clock.wv-wide",
      "style": {
        "display": "grid",
        "grid-template-columns": "1.2fr 1fr",
        "align-items": "center",
        "gap": "32px"
      }
    },
    "variant-clock-wide-time": {
      "selector": ".wv-clock.wv-wide .wv-time",
      "style": {
        "font-size": "86px"
      }
    },
    "variant-world": {
      "selector": ".wv-world",
      "style": {
        "display": "flex",
        "flex-direction": "column",
        "gap": "24px"
      }
    },
    "variant-world-row": {
      "selector": ".wv-world-row",
      "style": {
        "display": "flex",
        "align-items": "baseline",
        "justify-content": "space-between",
        "gap": "16px"
      }
    },
    "variant-world-time": {
      "selector": ".wv-world-time",
      "style": {
        "font": "30px var(--font-heading)"
      }
    },
    "variant-air-small": {
      "selector": ".wv-air-quality.wv-small",
      "style": {
        "justify-content": "center"
      }
    },
    "variant-air-wide": {
      "selector": ".wv-air-quality.wv-wide",
      "style": {
        "display": "grid",
        "grid-template-columns": "1fr 2fr",
        "align-items": "center",
        "gap": "30px"
      }
    },
    "variant-air-chart": {
      "selector": ".wv-air-chart",
      "style": {
        "height": "100%",
        "display": "flex",
        "flex-direction": "column",
        "gap": "12px",
        "min-height": "0"
      }
    },
    "variant-air-bars": {
      "selector": ".wv-air-bars",
      "style": {
        "height": "calc(100% - 32px)",
        "min-height": "0",
        "display": "flex",
        "gap": "14px",
        "align-items": "end"
      }
    },
    "variant-air-column": {
      "selector": ".wv-air-column",
      "style": {
        "height": "100%",
        "min-height": "0",
        "display": "flex",
        "flex-direction": "column",
        "justify-content": "end",
        "align-items": "center",
        "gap": "6px",
        "flex": "1"
      }
    },
    "variant-air-bar": {
      "selector": ".wv-air-bar",
      "style": {
        "width": "70%",
        "border-radius": "6px 6px 2px 2px",
        "background": "var(--color-accent)",
        "opacity": ".55",
        "flex-shrink": "1"
      }
    },
    "variant-weather": {
      "selector": ".wv-weather",
      "style": {
        "gap": "20px",
        "justify-content": "center"
      }
    },
    "variant-weather-now": {
      "selector": ".wv-weather-now",
      "style": {
        "display": "flex",
        "flex-wrap": "wrap",
        "align-items": "center",
        "gap": "8px 12px",
        "flex": "0 0 auto"
      }
    },
    "variant-weather-value": {
      "selector": ".wv-weather-now > .wv-value",
      "style": {
        "font-size": "62px"
      }
    },
    "variant-weather-icon": {
      "selector": ".wv-weather-icon",
      "style": {
        "width": "44px",
        "height": "44px",
        "object-fit": "contain"
      }
    },
    "variant-weather-sun": {
      "selector": ".wv-weather-now > .wv-note",
      "style": {
        "flex-basis": "100%",
        "color": "var(--color-text-secondary)",
        "font-size": "15px"
      }
    },
    "variant-hours": {
      "selector": ".wv-hours",
      "style": {
        "display": "grid",
        "grid-template-columns": "repeat(3,minmax(0,1fr))",
        "gap": "12px",
        "align-items": "center"
      }
    },
    "variant-hour": {
      "selector": ".wv-hour",
      "style": {
        "display": "flex",
        "flex-direction": "column",
        "align-items": "center",
        "gap": "10px",
        "min-width": "0"
      }
    },
    "variant-hour-temp": {
      "selector": ".wv-hour-temp",
      "style": {
        "font": "36px var(--font-heading)"
      }
    },
    "variant-hour-icon": {
      "selector": ".wv-hour-icon",
      "style": {
        "width": "32px",
        "height": "32px"
      }
    },
    "variant-weather-wide": {
      "selector": ".wv-weather.wv-wide",
      "style": {
        "display": "grid",
        "grid-template-columns": "1fr 2fr",
        "align-items": "center",
        "gap": "30px"
      }
    },
    "variant-weather-wide-hours": {
      "selector": ".wv-weather.wv-wide .wv-hours",
      "style": {
        "grid-template-columns": "repeat(6,minmax(0,1fr))",
        "gap": "8px"
      }
    },
    "variant-news": {
      "selector": ".wv-hacker-news",
      "style": {
        "justify-content": "space-evenly",
        "gap": "12px"
      }
    },
    "variant-story": {
      "selector": ".wv-story",
      "style": {
        "display": "flex",
        "gap": "12px",
        "align-items": "center",
        "min-height": "0",
        "min-width": "0"
      }
    },
    "variant-rank": {
      "selector": ".wv-rank",
      "style": {
        "font": "28px var(--font-heading)",
        "color": "var(--color-accent)",
        "min-width": "24px",
        "flex": "0 0 auto"
      }
    },
    "variant-headline": {
      "selector": ".wv-headline",
      "style": {
        "font-size": "19px",
        "line-height": "1.25",
        "display": "block",
        "overflow": "hidden",
        "margin-bottom": "6px",
        "max-height": "none",
        "overflow-wrap": "anywhere"
      }
    },
    "variant-news-small-title": {
      "selector": ".wv-hacker-news.wv-small .wv-headline",
      "style": {
        "font-size": "21px"
      }
    },
    "variant-news-columns": {
      "selector": ".wv-hacker-news:is(.wv-wide,.wv-large)",
      "style": {
        "display": "grid",
        "grid-template-columns": "1fr 1fr",
        "grid-auto-rows": "minmax(0,1fr)",
        "gap": "18px 30px"
      }
    },
    "variant-painting": {
      "selector": ".wv-daily",
      "style": {
        "gap": "12px"
      }
    },
    "variant-painting-image": {
      "selector": ".wv-painting-image",
      "style": {
        "flex": "1 1 0",
        "min-height": "0",
        "display": "flex",
        "align-items": "center",
        "justify-content": "center"
      }
    },
    "variant-painting-img": {
      "selector": ".wv-painting-image img",
      "style": {
        "display": "block",
        "width": "100%",
        "height": "100%",
        "object-fit": "contain",
        "min-height": "0"
      }
    },
    "variant-painting-label": {
      "selector": ".wv-painting-label",
      "style": {
        "display": "flex",
        "flex-direction": "column",
        "gap": "5px",
        "flex": "0 0 auto",
        "min-width": "0"
      }
    },
    "variant-painting-title": {
