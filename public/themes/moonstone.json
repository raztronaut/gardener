        "max-height": "100% !important",
        "min-width": "0",
        "box-sizing": "border-box",
        "align-self": "stretch",
        "order": "0 !important",
        "padding": "calc(var(--home-title-top) + var(--home-title-height) + var(--home-title-gap) - 1px) calc(var(--home-card-inset) - 1px) 21px !important",
        "overflow": "hidden !important"
      }
    },
    "home-standard-title": {
      "selector": "body[data-dash=\"main\"] #garden.home-paged[data-layout=\"standard\"] > .card > .card-title",
      "style": {
        "left": "calc(var(--home-card-inset) - 1px)",
        "top": "calc(var(--home-title-top) - 1px)",
        "line-height": "var(--home-title-height)",
        "max-width": "calc(100% - var(--home-card-inset) - 100px)",
        "white-space": "nowrap",
        "overflow": "hidden",
        "text-overflow": "ellipsis"
      }
    },
    "home-standard-body": {
      "selector": "body[data-dash=\"main\"] #garden.home-paged[data-layout=\"standard\"] > .card > .card-body",
      "style": {
        "min-height": "0",
        "height": "100%",
        "flex": "1 1 0"
      }
    },
    "home-standard-clock": {
      "selector": "body[data-dash=\"main\"] #garden.home-paged[data-layout=\"standard\"] > .card[data-wid=\"clock\"]",
      "style": {
        "padding": "var(--home-card-inset) !important",
        "justify-content": "center"
      }
    },
    "home-standard-fractal": {
      "selector": "body[data-dash=\"main\"] #garden.home-paged[data-layout=\"standard\"] > .card[data-wid=\"fractal\"]",
      "style": {
        "padding": "0 !important"
      }
    },
    "home-standard-fractal-title": {
      "selector": "body[data-dash=\"main\"] #garden.home-paged[data-layout=\"standard\"] > .card[data-wid=\"fractal\"] .frc .ttl",
      "style": {
        "left": "var(--home-card-inset)",
        "top": "var(--home-title-top)",
        "line-height": "var(--home-title-height)"
      }
    },
    "home-standard-fractal-art": {
      "selector": "body[data-dash=\"main\"] #garden.home-paged[data-layout=\"standard\"] > .card[data-wid=\"fractal\"] .frc .art",
      "style": {
        "left": "var(--home-card-inset)",
        "right": "var(--home-card-inset)",
        "top": "calc(var(--home-title-top) + var(--home-title-height) + var(--home-title-gap))",
        "bottom": "22px"
      }
    },
    "home-editbar-buttons": {
      "selector": ".home-edit-bar > button",
      "style": {
        "height": "44px",
        "min-height": "44px",
        "box-sizing": "border-box",
        "padding": "0 16px",
        "border-radius": "calc(31px - 8px - 1px)"
      }
    },
    "home-control-target": {
      "selector": "body[data-dash=\"main\"] #garden.home-paged > .card > .widget-edit-controls > button::before",
      "style": {
        "content": "\"\"",
        "position": "absolute",
        "inset": "-8px",
        "border-radius": "50%"
      }
    },
    "home-drawer-spacing": {
      "selector": ".widget-drawer",
      "style": {
        "border-radius": "32px",
        "padding": "20px"
      }
    },
    "home-gallery-button-radius": {
      "selector": ".widget-gallery .widget-gallery-item",
      "style": {
        "border-radius": "calc(32px - 20px - 1px)"
      }
    },
    "home-standard-preview": {
      "selector": ".standard-preview-frame",
      "style": {
        "--home-card-inset": "max(20px, var(--radius-card))",
        "--home-title-top": "18px",
        "--home-title-height": "18px",
        "--home-title-gap": "12px",
        "box-sizing": "border-box",
        "padding": "47px calc(var(--home-card-inset) - 1px) 21px !important",
        "overflow": "hidden"
      }
    },
    "home-standard-preview-title": {
      "selector": ".standard-preview-frame > .card-title",
      "style": {
        "left": "calc(var(--home-card-inset) - 1px)",
        "top": "17px",
        "line-height": "18px"
      }
    },
    "home-standard-preview-clock": {
      "selector": ".standard-preview-frame.clk, .standard-preview-frame.bare:not(:has(.frc,.wv-fractal))",
      "style": {
        "padding": "var(--home-card-inset) !important"
      }
    },
    "home-standard-preview-fractal": {
      "selector": ".standard-preview-frame.bare:has(.frc,.wv-fractal)",
      "style": {
        "padding": "0 !important"
      }
    },
    "home-standard-preview-fractal-title": {
      "selector": ".standard-preview-frame .frc .ttl",
      "style": {
        "top": "18px",
        "left": "var(--home-card-inset)"
      }
    },
    "home-standard-preview-fractal-art": {
      "selector": ".standard-preview-frame .frc .art",
      "style": {
        "top": "48px",
        "left": "var(--home-card-inset)",
        "right": "var(--home-card-inset)",
        "bottom": "22px"
      }
    },
    "home-standard-empty": {
      "selector": "body[data-dash=\"main\"] #garden.home-paged[data-layout=\"standard\"] > .widget-page-empty",
      "style": {
        "grid-column": "1 / -1",
        "order": "0",
        "align-self": "center"
      }
    },
    "home-standard-news-clamp": {
      "selector": ".wv-hacker-news .wv-headline",
      "style": {
        "display": "-webkit-box",
        "-webkit-line-clamp": "3",
        "-webkit-box-orient": "vertical",
        "overflow": "hidden"
      }
    },
    "home-standard-news-wide-clamp": {
      "selector": ".wv-hacker-news:is(.wv-wide,.wv-large) .wv-headline",
      "style": {
        "-webkit-line-clamp": "4"
      }
    },
    "home-standard-transit-small": {
      "selector": ".wv-transit.wv-small",
      "style": {
        "gap": "8px"
      }
    },
    "home-standard-transit-small-row": {
      "selector": ".wv-transit.wv-small .wv-departure",
      "style": {
        "gap": "10px"
      }
    },
    "home-standard-transit-small-destination": {
      "selector": ".wv-transit.wv-small .wv-destination-name",
      "style": {
        "font-size": "18px",
        "line-height": "1.2"
      }
    },
    "home-standard-transit-small-route": {
      "selector": ".wv-transit.wv-small .wv-route",
      "style": {
        "font-size": "26px"
      }
    }
  },
  "widgets": {
    "clock": {
      "columns": 2,
      "rows": 1,
      "parts": {
        ".time": {
          "font-size": "86px",
          "letter-spacing": "-.04em"
        }
      }
    },
    "weather": {
      "parts": {
        ".wx-now .f": {
          "color": "var(--color-text-primary)"
        }
      }
    },
    "transit": {
      "columns": 2,
      "rows": 1
    }
  },
  "$schema": "./schema/theme.schema.json"
}
