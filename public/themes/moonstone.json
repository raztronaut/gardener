{
  "version": 1,
  "id": "moonstone",
  "label": "Moonstone",
  "tokens": {
    "palette": {
      "--palette-canvas": "#15131c",
      "--palette-canvas-raised": "#201d2c",
      "--palette-text-primary": "#f4effa",
      "--palette-text-secondary": "#c8bfd8",
      "--palette-text-muted": "#afa4c1",
      "--palette-accent": "#d6c0ff",
      "--palette-accent-secondary": "#b7c9f3",
      "--palette-warning": "#f3d98e",
      "--palette-error": "#ffa5bd",
      "--palette-button-fill": "#cbb3f1",
      "--palette-button-text": "#21192d",
      "--palette-button-hover": "#dcc7fa",
      "--palette-choice-fill": "#2b2538",
      "--palette-choice-selected": "#453552"
    },
    "colors": {
      "--color-canvas": "var(--palette-canvas)",
      "--color-canvas-raised": "var(--palette-canvas-raised)",
      "--color-text-primary": "var(--palette-text-primary)",
      "--color-text-secondary": "var(--palette-text-secondary)",
      "--color-text-muted": "var(--palette-text-muted)",
      "--color-accent": "var(--palette-accent)",
      "--color-accent-secondary": "var(--palette-accent-secondary)",
      "--color-warning": "var(--palette-warning)",
      "--color-error": "var(--palette-error)",
      "--color-button-fill": "var(--palette-button-fill)",
      "--color-button-text": "var(--palette-button-text)",
      "--color-button-hover": "var(--palette-button-hover)",
      "--color-choice-fill": "var(--palette-choice-fill)",
      "--color-choice-text": "var(--palette-text-primary)",
      "--color-choice-description": "var(--palette-text-secondary)",
      "--color-choice-selected": "var(--palette-choice-selected)",
      "--color-accent-wash": "rgba(214,192,255,.14)",
      "--color-accent-ring": "rgba(214,192,255,.5)",
      "--color-overlay-text": "var(--palette-text-primary)",
      "--color-overlay-description": "var(--palette-text-secondary)",
      "--color-dialog-veil": "rgba(12,9,20,.55)"
    },
    "typography": {
      "--font-body": "\"Space Grotesk\", sans-serif",
      "--font-code": "\"Space Grotesk\", sans-serif",
      "--font-heading": "\"Instrument Serif\", serif",
      "--text-body": "18px",
      "--text-label": "13px",
      "--text-heading": "36px",
      "--text-description": "19px"
    },
    "spacing": {
      "--space-grid-gap": "14px",
      "--space-card-padding": "18px",
      "--space-button-padding": "10px 14px",
      "--space-shell-padding": "30px 26px 22px"
    },
    "shape": {
      "--radius-card": "8px",
      "--radius-button": "8px",
      "--radius-choice": "12px",
      "--radius-overlay": "12px"
    },
    "materials": {
      "--surface-overlay": "#252131",
      "--surface-raised": "#302a40",
      "--surface-hover": "#3b314d",
      "--surface-selected": "#453552",
      "--surface-glass": "#2b2538",
      "--surface-glass-raised": "#252131",
      "--glass-base": "#252131",
      "--glass-tint": "#252131",
      "--glass-fill": "linear-gradient(#252331, #252331)",
      "--border-subtle": "rgba(210,195,235,.2)",
      "--border-strong": "rgba(210,195,235,.4)",
      "--glass-rim": "rgba(210,195,235,.2)",
      "--glass-edge": "none",
      "--glass-drop": "0 12px 30px -18px rgba(0,0,0,.5)",
      "--shadow-overlay": "0 18px 50px rgba(0,0,0,.3)",
      "--surface-canvas-aura": "radial-gradient(ellipse at 0 0, #393046, transparent 65%), var(--color-canvas)",
      "--shadow-drag-ghost": "0 20px 60px #0008"
    },
    "cursor": {
      "--cursor-default": "url('/themes/cursors/arrow.svg') 2 2, default",
      "--cursor-pointer": "url('/themes/cursors/hand.svg') 10 2, pointer",
      "--cursor-text": "url('/themes/cursors/text.svg') 8 13, text"
    },
    "overrides": {}
  },
  "layout": {
    "columns": 4,
    "rowSize": "minmax(60px, auto)",
    "align": "stretch"
  },
  "components": {
    "canvas": {
      "selector": ".aurora",
      "style": {
        "background": "var(--surface-canvas-aura)"
      }
    },
    "shell": {
      "selector": "#stage",
      "style": {
        "padding": "var(--space-shell-padding)"
      }
    },
    "brand": {
      "selector": ".brand h1",
      "style": {
        "background": "none",
        "color": "var(--color-text-primary)",
        "font-size": "38px",
        "letter-spacing": "-.03em"
      }
    },
    "grain": {
      "selector": ".grain",
      "style": {
        "opacity": ".025"
      }
    },
    "surfaces": {
      "selector": ".card:not(.unframed), .panel-card, #feedbackForm, .cmd-palette, .cp-glass",
      "style": {
        "background": "var(--glass-fill) !important",
        "border-color": "var(--border-subtle)",
        "box-shadow": "var(--glass-drop)",
        "border-radius": "var(--radius-card)"
      }
    },
    "glass-decoration": {
      "selector": ".gb-img, .lgr-tint, .lgr-rim",
      "style": {
        "visibility": "hidden"
      }
    },
    "card-heading": {
      "selector": ".card-title",
      "style": {
        "font-family": "var(--font-body)",
        "font-size": "var(--text-label)",
        "color": "var(--color-text-secondary)",
        "letter-spacing": ".12em",
        "text-transform": "uppercase"
      }
    },
    "buttons": {
      "selector": "#stage button:not(.theme-choice), #panel button:not(.theme-choice)",
      "style": {
        "background-color": "var(--color-button-fill)",
        "color": "var(--color-button-text)",
        "padding": "var(--space-button-padding)",
        "border-radius": "var(--radius-button)"
      }
    },
    "button-hover": {
      "selector": "#stage button:not(.theme-choice):hover, #panel button:not(.theme-choice):hover",
      "style": {
        "background-color": "var(--color-button-hover)"
      }
    },
    "theme-choice": {
      "selector": "#panel .theme-choice",
      "style": {
        "background": "var(--color-choice-fill)",
        "color": "var(--color-choice-text)",
        "border-radius": "var(--radius-choice)",
        "padding": "22px"
      }
    },
    "theme-choice-description": {
      "selector": "#panel .theme-choice span",
      "style": {
        "color": "var(--color-choice-description)",
        "font-size": "var(--text-description)"
      }
    },
    "theme-choice-selected": {
      "selector": "#panel .theme-choice[aria-pressed=\"true\"]",
      "style": {
        "background": "var(--color-choice-selected)",
        "border-color": "var(--color-accent)"
      }
    },
    "hover-rim": {
      "selector": ".card.lgr::after",
      "style": {
        "box-shadow": "inset 0 0 0 1px var(--color-accent)"
      }
    },
    "card-copy": {
      "selector": ".card-body",
      "style": {
        "font-size": "var(--text-body)",
        "line-height": "1.35"
      }
    },
    "veil": {
      "selector": "#panel",
      "style": {
        "background": "var(--color-dialog-veil)"
      }
    },
    "widget-edit-controls": {
      "selector": "#garden > .card .widget-edit-controls button",
      "style": {
        "border-radius": "50% !important",
        "padding": "0 !important",
        "background": "var(--color-canvas-raised) !important",
        "color": "var(--color-text-primary) !important",
        "border": "1px solid var(--border-strong) !important"
      }
    },
    "floating-surfaces": {
      "selector": "#rfMenu, #volMenu, #volpill, #voiceCap, #botanistCard, #countdownCard, #voiceCalib .vk-card, .mdeditor, .widget-edit-bar, .widget-drawer",
      "style": {
        "background": "var(--surface-overlay) !important",
        "color": "var(--color-overlay-text)",
        "border-color": "var(--border-strong)",
        "border-radius": "var(--radius-overlay)",
        "box-shadow": "var(--shadow-overlay)"
      }
    },
    "forest-menu": {
      "selector": "#rfMenu",
      "style": {
        "max-width": "min(760px, calc(100vw - 48px))",
        "max-height": "calc(100vh - 180px)",
        "overflow-y": "auto",
        "padding": "10px"
      }
    },
    "forest-row": {
      "selector": "#rfMenu .rfm-row",
      "style": {
        "border-radius": "var(--radius-button)",
        "padding": "12px 14px",
        "background": "transparent",
        "color": "var(--color-overlay-text)"
      }
    },
    "forest-copy": {
      "selector": "#rfMenu .rfm-row small",
      "style": {
        "color": "var(--color-overlay-description)",
        "font-size": "14px",
        "line-height": "1.4"
      }
    },
    "forest-text-wrap": {
      "selector": "#rfMenu .rfm-row .tx",
      "style": {
        "min-width": "0"
      }
    },
    "forest-hover": {
      "selector": "#rfMenu .rfm-row:hover, #rfMenu .rfm-row:focus-visible",
      "style": {
        "background": "var(--surface-hover)"
      }
    },
    "forest-selection": {
      "selector": "#rfMenu .rfm-row.sel",
      "style": {
        "background": "var(--surface-selected)",
        "box-shadow": "inset 0 0 0 1px var(--color-accent-ring)"
      }
    },
    "forest-active": {
      "selector": "#rfMenu .rfm-row.on b, #rfMenu .rfm-row.on .ic",
      "style": {
        "color": "var(--color-accent)"
      }
    },
    "volume-controls": {
      "selector": "#volMenu .vm-step",
      "style": {
        "background": "var(--surface-raised)",
        "color": "var(--color-overlay-text)",
        "border-radius": "var(--radius-button)",
        "border-color": "var(--border-strong)"
      }
    },
    "volume-hover": {
      "selector": "#volMenu .vm-step:hover",
      "style": {
        "background": "var(--surface-hover)",
        "color": "var(--color-accent)"
      }
    },
    "volume-thumb": {
      "selector": "#volMenu input[type=range]::-webkit-slider-thumb",
      "style": {
        "background": "var(--color-text-primary)",
        "box-shadow": "0 0 0 3px var(--color-accent-ring)"
      }
    },
    "focused-header-control": {
      "selector": "#volBtn.focused, #rfBtn.focused",
      "style": {
        "background": "var(--surface-hover)",
        "color": "var(--color-text-primary)",
        "box-shadow": "inset 0 0 0 1px var(--color-accent-ring)"
      }
    },
    "command-selection": {
      "selector": ".cp-row.sel",
      "style": {
        "background": "var(--surface-selected)"
      }
    },
    "command-description": {
      "selector": ".cp-explain .cp-desc",
      "style": {
        "color": "var(--color-overlay-text)"
      }
    },
    "botanist-header": {
      "selector": "#botanistCard .bc-head",
      "style": {
        "background": "var(--surface-raised)",
        "border-bottom-color": "var(--border-subtle)"
      }
    },
    "botanist-copy": {
      "selector": "#botanistCard .bc-who, #botanistCard .bc-tx",
      "style": {
        "color": "var(--color-overlay-text)"
      }
    },
    "botanist-normal-dot": {
      "selector": "#botanistCard:not(.permission):not(.error) .bc-dot",
      "style": {
        "box-shadow": "0 0 10px var(--color-accent-ring)"
      }
    },
    "countdown-track": {
      "selector": "#countdownCard .cd-bar",
      "style": {
        "background": "var(--color-accent-wash)"
      }
    },
    "calibration-dot": {
      "selector": "#voiceCalib .vk-dots i",
      "style": {
        "box-shadow": "0 0 10px var(--color-accent-ring)"
      }
    },
    "voice-thinking": {
      "selector": "#voiceCap.think .vc-tx",
      "style": {
        "color": "var(--color-overlay-description)"
      }
    },
    "voice-step-label": {
      "selector": ".vs-steps li b",
      "style": {
        "color": "var(--color-button-text)"
      }
    },
    "inline-edit": {
      "selector": ".pruning",
      "style": {
        "background": "var(--color-accent-wash)"
      }
    },
    "changelog-label": {
      "selector": ".help-cmd code",
      "style": {
        "background": "var(--color-accent-wash)"
      }
    },
    "grow-note": {
      "selector": ".grow-running",
      "style": {
        "background": "var(--color-accent-wash)"
      }
    },
    "event-number": {
      "selector": ".ev-no",
      "style": {
        "background": "var(--color-accent)",
        "color": "var(--color-button-text)"
      }
    },
    "widget-select-options": {
      "selector": ".widget-manager select option",
      "style": {
        "background": "var(--surface-overlay)",
        "color": "var(--color-overlay-text)"
      }
    },
    "game-prompt-controls": {
      "selector": ".headline-game button",
      "style": {
        "background": "var(--surface-raised)",
        "color": "var(--color-overlay-text)",
        "border-radius": "var(--radius-button)"
      }
    },
    "alarm-dialog": {
      "selector": ".oa-card",
      "style": {
        "background": "var(--surface-overlay)",
        "border-color": "var(--border-strong)",
        "border-radius": "var(--radius-overlay)"
      }
    },
    "list-hover": {
      "selector": ".cl-row.clickable:hover, .cl-row.row-sel, .rc-chore.on",
      "style": {
        "background": "var(--color-accent-wash)",
        "box-shadow": "inset 0 0 0 1px var(--color-accent-ring)"
      }
    },
    "gallery-buttons": {
      "selector": ".widget-edit-bar button, .widget-drawer button",
      "style": {
        "background": "var(--surface-raised)",
        "color": "var(--color-overlay-text)",
        "border-color": "var(--border-strong)",
        "border-radius": "var(--radius-button)"
      }
    },
    "gallery-buttons-hover": {
      "selector": ".widget-edit-bar button:hover, .widget-drawer button:hover",
      "style": {
        "background": "var(--surface-hover)"
      }
    },
    "toast": {
      "selector": "#toast",
      "style": {
        "background": "var(--surface-overlay)",
        "color": "var(--color-overlay-text)",
        "border-radius": "var(--radius-overlay)"
      }
    },
    "home-editing": {
      "selector": "body[data-dash=\"main\"] #garden.home-paged > .card.widget-editing",
      "style": {
        "outline": "1px dashed var(--border-strong)",
        "outline-offset": "-2px",
        "touch-action": "none",
        "user-select": "none",
        "overflow": "hidden !important"
      }
    },
    "home-edit-stable": {
      "selector": "body[data-dash=\"main\"].editing-widgets #garden.home-paged",
      "style": {
        "padding": "2px !important",
        "gap": "var(--space-grid-gap) !important",
        "overflow": "hidden !important"
      }
    },
    "home-dots": {
      "selector": ".home-page-dots > button",
      "style": {
        "width": "24px !important"
      }
    },
    "home-editbar": {
      "selector": ".home-edit-bar",
      "style": {
        "top": "auto",
        "bottom": "26px",
        "left": "30px",
        "right": "30px",
        "height": "62px",
        "padding": "8px",
        "box-sizing": "border-box",
        "border-radius": "31px",
        "background": "var(--color-canvas-raised)",
        "gap": "12px"
      }
    },
    "home-input-edit": {
      "selector": "body[data-dash=\"main\"].editing-widgets #feedbackForm",
      "style": {
        "visibility": "hidden"
      }
    },
    "home-controls": {
      "selector": "body[data-dash=\"main\"] #garden.home-paged > .card > .widget-edit-controls",
      "style": {
        "inset": "0",
        "display": "block",
        "pointer-events": "none"
      }
    },
    "home-control-button": {
      "selector": "body[data-dash=\"main\"] #garden.home-paged > .card > .widget-edit-controls > button",
      "style": {
        "position": "absolute",
        "width": "28px",
        "height": "28px",
        "padding": "0",
        "font-size": "18px",
        "pointer-events": "auto",
        "min-width": "28px",
        "min-height": "28px",
        "box-sizing": "border-box"
      }
    },
    "home-remove": {
      "selector": "body[data-dash=\"main\"] #garden.home-paged > .card > .widget-edit-controls > button:first-child:not(.widget-drag-handle)",
      "style": {
        "top": "max(7px, calc(var(--radius-card) - 15px))",
        "right": "max(7px, calc(var(--radius-card) - 15px))"
      }
    },
    "home-move": {
      "selector": "body[data-dash=\"main\"] #garden.home-paged > .card > .widget-edit-controls > .widget-drag-handle",
      "style": {
        "bottom": "6px",
        "left": "6px",
        "opacity": "0",
        "pointer-events": "none"
      }
    },
    "home-resize": {
      "selector": "body[data-dash=\"main\"] #garden.home-paged > .card > .widget-edit-controls > button:last-child",
      "style": {
        "bottom": "auto",
        "right": "calc(max(7px, calc(var(--radius-card) - 15px)) + 44px)",
        "top": "max(7px, calc(var(--radius-card) - 15px))"
      }
    },
    "home-drop": {
      "selector": "body[data-dash=\"main\"] #garden.home-paged > .card.widget-drop-target",
      "style": {
        "outline": "2px solid var(--color-accent)",
        "outline-offset": "-3px"
      }
    },
    "home-ghost": {
      "selector": ".home-drag-ghost",
      "style": {
        "z-index": "185",
        "pointer-events": "none",
        "opacity": ".85",
        "margin": "0",
        "transform": "none",
        "overflow": "hidden",
        "box-sizing": "border-box",
        "box-shadow": "var(--shadow-drag-ghost)"
      }
    },
    "home-picker": {
      "selector": ".widget-size-picker",
      "style": {
        "position": "fixed",
        "z-index": "184",
        "left": "24px",
        "right": "24px",
        "bottom": "100px",
        "padding": "20px",
        "border": "1px solid var(--border-strong)",
        "border-radius": "32px",
        "background": "var(--color-canvas-raised)",
        "color": "var(--color-text-primary)",
        "box-shadow": "var(--shadow-overlay)"
      }
    },
    "home-picker-hidden": {
      "selector": ".widget-size-picker[hidden]",
      "style": {
        "display": "none"
      }
    },
    "home-picker-head": {
      "selector": ".widget-size-picker h2",
      "style": {
        "font": "28px var(--font-heading)",
        "margin": "0"
      }
    },
    "home-picker-p": {
      "selector": ".widget-size-picker p",
      "style": {
        "color": "var(--color-text-secondary)",
        "margin": "12px 0 24px"
      }
    },
    "home-picker-options": {
      "selector": ".widget-size-options",
      "style": {
        "display": "grid",
        "grid-template-columns": "repeat(3,minmax(0,1fr))",
        "gap": "12px"
      }
    },
    "home-picker-button": {
      "selector": ".widget-size-picker button",
      "style": {
        "font": "inherit",
        "color": "var(--color-text-primary)",
        "background": "var(--surface-glass-raised)",
        "border": "1px solid var(--border-subtle)",
        "border-radius": "calc(32px - 20px - 1px)",
        "padding": "12px",
        "cursor": "pointer"
      }
    },
    "home-picker-option": {
      "selector": ".widget-size-options button",
      "style": {
        "display": "flex",
        "flex-direction": "column",
        "align-items": "stretch",
        "gap": "10px",
        "min-height": "240px",
        "text-align": "left",
        "padding": "12px"
      }
    },
    "home-picker-description": {
      "selector": ".widget-size-options button > span:last-child",
      "style": {
        "font-size": "13px",
        "color": "var(--color-text-secondary)"
      }
    },
    "home-picker-selected": {
      "selector": ".widget-size-options button[aria-pressed=\"true\"]",
      "style": {
        "border": "1px solid var(--color-accent)",
        "background": "var(--surface-glass)",
        "box-shadow": "inset 0 0 0 1px var(--color-accent)"
      }
    },
    "home-picker-shape": {
      "selector": ".widget-size-shape",
      "style": {
        "display": "block",
        "width": "38px",
        "height": "28px",
        "border": "1px solid var(--color-text-secondary)",
        "border-radius": "6px",
        "background": "var(--border-subtle)"
      }
    },
    "home-picker-medium": {
      "selector": ".widget-size-shape.medium",
      "style": {
        "height": "42px"
      }
    },
    "home-picker-wide": {
      "selector": ".widget-size-shape.wide",
      "style": {
        "width": "70px",
        "height": "35px"
      }
    },
    "home-picker-tall": {
      "selector": ".widget-size-shape.tall",
      "style": {
        "height": "62px"
      }
    },
    "home-picker-large": {
      "selector": ".widget-size-shape.large",
      "style": {
        "width": "70px",
        "height": "62px"
      }
    },
    "home-move-focus": {
      "selector": "body[data-dash=\"main\"] #garden.home-paged > .card > .widget-edit-controls > .widget-drag-handle:focus-visible",
      "style": {
        "opacity": "1"
      }
    },
    "home-clock-resize": {
      "selector": "body[data-dash=\"main\"] #garden.home-paged > .card[data-wid=\"clock\"] > .widget-edit-controls > button:last-child",
      "style": {
        "right": "max(7px, calc(var(--radius-card) - 15px))"
      }
    },
    "home-no-spacer": {
      "selector": "body[data-dash=\"main\"] #garden.home-paged::after",
      "style": {
        "display": "none !important"
      }
    },
    "home-explicit-small": {
      "selector": "body[data-dash=\"main\"] #garden.home-paged > .card[data-wsize=\"small\"]",
      "style": {
        "overflow": "hidden !important"
      }
    },
    "home-explicit-medium": {
      "selector": "body[data-dash=\"main\"] #garden.home-paged > .card[data-wsize=\"medium\"]",
      "style": {
        "overflow": "hidden !important"
      }
    },
    "home-explicit-wide": {
      "selector": "body[data-dash=\"main\"] #garden.home-paged > .card[data-wsize=\"wide\"]",
      "style": {
        "overflow": "hidden !important"
      }
    },
    "home-explicit-tall": {
      "selector": "body[data-dash=\"main\"] #garden.home-paged > .card[data-wsize=\"tall\"]",
      "style": {
        "overflow": "hidden !important"
