[Unit]
Description=The Gardener — daily tending (agentic iteration)
After=gardener-backend.service

[Service]
Type=oneshot
# Headless agent run; deterministic offscreen screenshots → no display needed.
# (iterate tolerates a not-yet-ready network by simply failing & retrying tomorrow)
ExecStart=/home/talbot/gardener/scripts/gardener.sh iterate scheduled
# Must exceed worst-case runtime (main 25m + up to 4 fix passes × 12m + overhead).
TimeoutStartSec=8100
