[Unit]
Description=The Gardener — kiosk browser (surf, fullscreen)
PartOf=graphical-session.target
After=graphical-session.target gardener-backend.service
Wants=gardener-backend.service

[Service]
Type=simple
Environment=DISPLAY=:0
ExecStart=/home/talbot/gardener/scripts/gardener.sh kiosk
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
