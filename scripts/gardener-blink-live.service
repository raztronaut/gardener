[Unit]
Description=The Gardener — Blink Live View daemon (always-on real-time video → frame)
After=gardener-backend.service
Wants=gardener-backend.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/talbot/gardener
ExecStart=/home/talbot/gardener/scripts/gardener.sh blink-live
Restart=always
RestartSec=5
MemoryHigh=220M

[Install]
WantedBy=default.target
