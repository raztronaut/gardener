[Unit]
Description=The Gardener — Blink camera motion poller (blinkpy → latest snapshot)
After=gardener-backend.service
Wants=gardener-backend.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/talbot/gardener
ExecStart=/home/talbot/gardener/scripts/gardener.sh blink
Restart=always
RestartSec=10
MemoryHigh=160M

[Install]
WantedBy=default.target
